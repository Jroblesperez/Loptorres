generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model Tenant { id String @id @default(cuid()) name String slug String @unique users User[] customers Customer[] products Product[] createdAt DateTime @default(now()) }
model User { id String @id @default(cuid()) tenantId String email String name String role String tenant Tenant @relation(fields: [tenantId], references: [id]) }
model Customer { id String @id @default(cuid()) tenantId String name String type String phone String? email String? stage String value Decimal @default(0) tenant Tenant @relation(fields: [tenantId], references: [id]) quotations Quotation[] }
model Product { id String @id @default(cuid()) tenantId String sku String name String category String cost Decimal price Decimal margin Decimal tenant Tenant @relation(fields: [tenantId], references: [id]) }
model Quotation { id String @id @default(cuid()) tenantId String customerId String status String subtotal Decimal tax Decimal total Decimal cost Decimal profit Decimal customer Customer @relation(fields: [customerId], references: [id]) items QuotationItem[] createdAt DateTime @default(now()) }
model QuotationItem { id String @id @default(cuid()) quotationId String productName String widthM Decimal heightM Decimal quantity Int unitPrice Decimal total Decimal quotation Quotation @relation(fields: [quotationId], references: [id]) }
